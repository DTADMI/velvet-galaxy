{
  "name": "velvet-galaxy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.8.1"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:ci": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright install --with-deps && playwright test --config=playwright.config.ts",
    "format": "prettier --write .",
    "prepare": "husky install",
    "db:migrate": "bash scripts/run-migrations.sh",
    "db:check": "echo 'Copy scripts/check-db-state.sql and run in Supabase SQL Editor'",
    "check:supabase-security": "node scripts/check-supabase-security.mjs",
    "run-all-checks": "pnpm lint && pnpm typecheck && pnpm check:supabase-security && pnpm build && pnpm test"
  },
